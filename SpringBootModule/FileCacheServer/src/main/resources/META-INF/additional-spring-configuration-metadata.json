{
  "properties": [
    {
      "name": "config.app-servers",
      "type": "com.soybeany.system.cache.server.config.ServerInfo",
      "description": "应用服务器配置."
    },
    {
      "name": "config.file-cache-dir",
      "type": "java.lang.String",
      "description": "本地缓存文件存储的目录."
    },
    {
      "name": "config.max-used-percent",
      "type": "java.lang.Float",
      "description": "允许缓存目录使用磁盘空间的最大比例（0 ~ 1）."
    },
    {
      "name": "config.download-timeout-sec",
      "type": "java.lang.Integer",
      "description": "下载请求的超时.",
      "defaultValue": 10
    },
    {
      "name": "config.concurrent-max-connections",
      "type": "java.lang.Integer",
      "description": "每个数据源最大并发连接数.",
      "defaultValue": 5
    },
    {
      "name": "config.concurrent-wait-timeout-sec",
      "type": "java.lang.Integer",
      "description": "并发等待的超时.",
      "defaultValue": 5
    },
    {
      "name": "config.temp-file-threshold-m",
      "type": "java.lang.Integer",
      "description": "启用临时文件的门槛."
    },
    {
      "name": "config.temp-file-retain-sec",
      "type": "java.lang.Integer",
      "description": "临时文件保留的时间."
    },
    {
      "name": "config.manager-hosts",
      "type": "java.lang.String",
      "description": "管理服务器配置，多个host使用“,”或“;”进行分隔."
    }
  ]
}